--- !u!114 &7998565911589896028
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5590263830795133275}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "M\u1ED7i ng\u01B0\u1EDDi b\u1EAFt \u0111\u1EA7u v\u1EDBi 300.000 \u0111\u1ED3ng.\n\u0110i theo th\u1EE9 t\u1EF1 32 \xF4; qua ho\u1EB7c d\u1EEBng \xF4 Xu\u1EA5t ph\xE1t nh\u1EADn 200.000.\nMua th\xE0nh ph\u1ED1 ho\u1EB7c b\xE3i bi\u1EC3n, tr\u1EA3 thu\xEA khi d\u1EEBng \u1EDF t\xE0i s\u1EA3n \u0111\u1ED1i th\u1EE7.\nTh\xE0nh ph\u1ED1 c\xF3 C\u1ECDc, Nh\xE0 1, Nh\xE0 2, Nh\xE0 3 v\xE0 Kh\xE1ch s\u1EA1n.\nS\u1EDF h\u1EEFu tr\u1ECDn ba qu\u1ED1c gia b\u1EA5t k\u1EF3 ho\u1EB7c \u0111\u1EE7 b\u1ED1n b\xE3i bi\u1EC3n \u0111\u1EC3 th\u1EAFng ngay.\nTrong t\xF9 t\u1ED1i \u0111a ba l\u01B0\u1EE3t ri\xEAng; \u1EDF l\u01B0\u1EE3t ba tung kh\xF4ng \u0111\xF4i ph\u1EA3i tr\u1EA3 200.000.\nChi ti\u1EBFt th\u1EBB, k\u1EF9 n\u0103ng, thu\u1EBF, thanh l\xFD v\xE0 h\u1EBFt gi\u1EDD \u0111\u01B0\u1EE3c hi\u1EC3n th\u1ECB trong tr\u1EADn."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e880d618e2573014ba84fa037c49cae5, type: 2}
